<Window x:Class="JboxTransfer.Webview2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JboxTransfer.Webview2"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JboxTransfer 桌面端 - v1.0.0"
        Width="1300" Height="700" Closing="Window_Closing"
        Loaded="Window_Loaded" WindowStartupLocation="CenterScreen"
        Icon="/jboxtransfer.ico"
        mc:Ignorable="d">
    <Grid>
        <wv2:WebView2 Name="webView" 
                      NavigationStarting="webView_NavigationStarting"
                      AllowDrop="True" SnapsToDevicePixels="True" />
    </Grid>
</Window>
