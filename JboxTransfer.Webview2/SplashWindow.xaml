<Window x:Class="JboxTransfer.Webview2.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JboxTransfer.Webview2"
        Title="SplashWindow"
        Width="600" Height="400"
        BorderThickness="0" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Icon="/jboxtransfer.ico"
        AllowsTransparency="True" ResizeMode="NoResize"
        mc:Ignorable="d">
    <Window.Background>
        <ImageBrush ImageSource="/splash_bg.png" Stretch="UniformToFill" />
    </Window.Background>
    <Grid>
        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
            <Image Width="128"
                   HorizontalAlignment="Center"
                   Source="/tboxtransfer-demo Copy 2.png" />

            <ProgressBar Height="16"
                         Margin="0,20,0,0"
                         BorderThickness="0" IsIndeterminate="True" Foreground="#FF31DAF2" />

            <TextBlock HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       FontSize="24" FontFamily="Microsoft Yahei">
                JboxTransfer 启动中...
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
